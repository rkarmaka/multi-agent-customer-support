# Active model provider for the ADK agents: "ollama" (local dev) or "nim" (prod).
PROVIDER=ollama

# NVIDIA NIM (used when PROVIDER=nim) — OpenAI-compatible endpoint.
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Ollama (used when PROVIDER=ollama) — local OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gemma4:26b

# NeMo Guardrails run their own Ollama-served safety models (gemma3:4b,
# llama-guard3), independent of PROVIDER. Point this at whatever host serves
# them — local Ollama by default, even when the agents run on NIM.
GUARDRAILS_BASE_URL=http://localhost:11434

# Supabase project (catalog + cart with RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Test shopper used by cart tools (signed-in anon client)
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=your-test-password
